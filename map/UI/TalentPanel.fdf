// ===== 天赋按钮模板：原生菜单按钮款式（抄 EscMenuButtonTemplate 的 5 态结构）=====
// 来源：游戏内置 UI\FrameDef\UI\EscMenuTemplates.fdf 的 EscMenuButtonTemplate（始终加载）。
// 用原生命名贴图（EscMenuButtonBackground / EscMenuButtonBorder / EscMenuButtonPushedBackground ...），
// 配合 DecorateFileNames，游戏按本地玩家种族自动换皮（四族按钮资源齐全，无需手写 4 套）。
// 创建类型仍为 BUTTON（DzCreateFrameByTagName("BUTTON",...,"TalentBtn")），与 Talent.lua 现有调用一致。
Frame "BUTTON" "TalentBtn"
{
    ControlStyle "AUTOTRACK|HIGHLIGHTONMOUSEOVER",
    ControlBackdrop "TalentBtn_BD",
    Frame "BACKDROP" "TalentBtn_BD"
    {
        DecorateFileNames,
        BackdropTileBackground,
        BackdropBackground "EscMenuButtonBackground",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize 0.0125,
        BackdropBackgroundSize 0.256,
        BackdropBackgroundInsets 0.005 0.005 0.005 0.005,
        BackdropEdgeFile "EscMenuButtonBorder",
    }
    ControlPushedBackdrop "TalentBtn_PD",
    Frame "BACKDROP" "TalentBtn_PD"
    {
        DecorateFileNames,
        BackdropTileBackground,
        BackdropBackground "EscMenuButtonPushedBackground",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize 0.0125,
        BackdropBackgroundSize 0.256,
        BackdropBackgroundInsets 0.005 0.005 0.005 0.005,
        BackdropEdgeFile "EscMenuButtonPushedBorder",
    }
    ControlDisabledBackdrop "TalentBtn_DD",
    Frame "BACKDROP" "TalentBtn_DD"
    {
        DecorateFileNames,
        BackdropTileBackground,
        BackdropBackground "EscMenuButtonDisabledBackground",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize 0.0125,
        BackdropBackgroundSize 0.256,
        BackdropBackgroundInsets 0.005 0.005 0.005 0.005,
        BackdropEdgeFile "EscMenuButtonDisabledBorder",
    }
    ControlDisabledPushedBackdrop "TalentBtn_DPD",
    Frame "BACKDROP" "TalentBtn_DPD"
    {
        DecorateFileNames,
        BackdropTileBackground,
        BackdropBackground "EscMenuButtonDisabledPushedBackground",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize 0.0125,
        BackdropBackgroundSize 0.256,
        BackdropBackgroundInsets 0.005 0.005 0.005 0.005,
        BackdropEdgeFile "EscMenuButtonDisabledPushedBorder",
    }
    ControlMouseOverHighlight "TalentBtn_HL",
    Frame "HIGHLIGHT" "TalentBtn_HL"
    {
        DecorateFileNames,
        HighlightType "FILETEXTURE",
        HighlightAlphaFile "EscMenuButtonMouseOverHighlight",
        HighlightAlphaMode "ADD",
    }
}

// 内容 scrim（规格第三节）：中性深色半透，垫在主背景之上、所有文字/节点之下，保证对比度。
// Alpha 0.5 为起点（区间 0.45~0.60，TUNE）。
Frame "BACKDROP" "TalentScrim"
{
    Width 1.0, Height 1.0,
    BackdropBackground "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
    BackdropBlendAll,
    Alpha 0.25,
}
