// ============================================================
// BACKDROP — 天赋面板背景（FDF 定义，自带边框 + 半透明底）
// 由 GameTalent.lua 通过 Frame:newByTag("BACKDROP", name, container, "TalentPanelBg") 创建
// ============================================================
Frame "BACKDROP" "TalentPanelBg"
{
    Width 0.625,
    Height 0.4815,

    BackdropTileBackground,
    BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize  0.03,
    BackdropBackgroundSize  0.032,
    BackdropBackgroundInsets 0.01f 0.01f 0.01f 0.01f,
    BackdropEdgeFile  "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    BackdropBlendAll,
}

// 提示框风格背景（供新版天赋界面统一使用：背景 + 细边框一体）
Frame "BACKDROP" "TalentTooltipBg"
{
    Width 0.625,
    Height 0.4815,

    BackdropTileBackground,
    BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize  0.012,
    BackdropBackgroundSize  0.032,
    BackdropBackgroundInsets 0.004f 0.004f 0.004f 0.004f,
    BackdropEdgeFile  "UI\Widgets\ToolTips\Human\human-tooltip-border.blp",
    BackdropBlendAll,
}


// ============================================================
// 种族主题模板（规格 design/gdd/talent_race_theme.md §2.2 / §4.2 / §4.3 / §三）
// 原 TalentPanelBg（Human tooltip 样式）保留作兼容别名 / fallback，见上方定义。
// ============================================================

// Human（人族背景）— 与原 TalentPanelBg 并存；Lua 当前按 minimal-change 走原 TalentPanelBg（第七节），
// 本模板为规格 §2.2 定义、预留给后续将 Human 也迁移到 tile 样式。
Frame "BACKDROP" "TalentPanelBgHuman"
{
    Width 0.625, Height 0.4815,
    BackdropTileBackground,
    BackdropBackground  "UI\Console\Human\HumanUITile01.blp",
