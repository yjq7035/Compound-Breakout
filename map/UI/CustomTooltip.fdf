// ============================================================
// BACKDROP — Tooltip 背景模板
// ============================================================
Frame "BACKDROP" "CTooltipBg"
{
    Width 0.0745,
    Height 0.04325,

    BackdropTileBackground,
    BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize  0.012,
    BackdropBackgroundSize  0.032,
    BackdropBackgroundInsets 0.004f 0.004f 0.004f 0.004f,
    BackdropEdgeFile  "UI\Widgets\ToolTips\Human\human-tooltip-border.blp",
    BackdropBlendAll,
}

// ============================================================
// BUTTON — 商店刷新按钮模板
//   全部使用原生 War3 内置纹理
//   ControlStyle AUTOTRACK|HIGHLIGHTONMOUSEOVER 自动管理悬停高亮
//   Lua 创建后可用 setTexture 覆盖为图标纹理
//   按钮尺寸由 Lua setSize 覆盖
// ============================================================
Frame "BUTTON" "SkillShopRefreshButton"
{
    Width 0.03,
    Height 0.03,

    ControlStyle "AUTOTRACK|HIGHLIGHTONMOUSEOVER",

    // 普通态背景
    ControlBackdrop "SkillShopRefresh_Normal",
    Frame "BACKDROP" "SkillShopRefresh_Normal"
    {
        BackdropTileBackground,
        BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize  0.006,
        BackdropBackgroundSize  0.018,
        BackdropBackgroundInsets 0.001f 0.001f 0.001f 0.001f,
        BackdropEdgeFile  "UI\Widgets\ToolTips\Human\human-tooltip-border.blp",
        BackdropBlendAll,
    }

    // 按下态背景
    ControlPushedBackdrop "SkillShopRefresh_Pushed",
    Frame "BACKDROP" "SkillShopRefresh_Pushed"
    {
        BackdropTileBackground,
        BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize  0.006,
        BackdropBackgroundSize  0.018,
        BackdropBackgroundInsets 0.003f 0.003f 0.003f 0.003f,
        BackdropEdgeFile  "UI\Widgets\ToolTips\Human\human-tooltip-border.blp",
        BackdropBlendAll,
    }

    // 禁用态背景
    ControlDisabledBackdrop "SkillShopRefresh_Disabled",
    Frame "BACKDROP" "SkillShopRefresh_Disabled"
    {
        BackdropTileBackground,
        BackdropBackground  "UI\Widgets\ToolTips\Human\human-tooltip-background.blp",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize  0.006,
        BackdropBackgroundSize  0.018,
        BackdropBackgroundInsets 0.001f 0.001f 0.001f 0.001f,
        BackdropEdgeFile  "UI\Widgets\ToolTips\Human\human-tooltip-border.blp",
        BackdropBlendAll,
    }

    // 悬停高亮（鼠标经过时自动发光）
    ControlMouseOverHighlight "SkillShopRefresh_Highlight",
    Frame "HIGHLIGHT" "SkillShopRefresh_Highlight"
    {
        HighlightType "FILETEXTURE",
        HighlightAlphaFile "UI\Widgets\EscMenu\Human\quest-button-highlight.blp",
        HighlightAlphaMode "ADD",
    }
}